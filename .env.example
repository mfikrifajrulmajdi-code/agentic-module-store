# KASKU AI Environment Configuration Template

# Server Settings
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Event Bus & Caching
EVENT_BUS_TYPE=local # 'local' or 'redis'
REDIS_URL=redis://localhost:6379

# Multi-LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Tiering Setup (Groq Defaults)
TIER_1_MODEL=llama-3.1-8b-instant
TIER_2_MODEL=llama-3.3-70b-versatile
TIER_3_MODEL=llama-3.3-70b-versatile
